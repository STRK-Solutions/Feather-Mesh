    "parameters": {
      "additionalProperties": false,
      "properties": {
        "handle": {
          "type": "string"
        }
      },
      "required": [
        "handle"
      ],
      "type": "object"
    }
  },
  {
    "name": "product.withdraw",
    "description": "Open a local review using an operations handle whose tool is product.withdraw. Exact version and reason are ALREADY selected locally; the private reason is intentionally omitted. No extra reason text is needed from the model. This only opens review; it cannot withdraw directly.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "handle": {
          "type": "string"
        }
      },
      "required": [
        "handle"
      ],
      "type": "object"
    }
  }
