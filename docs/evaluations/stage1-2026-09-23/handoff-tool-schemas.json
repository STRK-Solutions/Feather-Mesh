[
  {
    "name": "user.clarify",
    "description": "Ask the local user to choose a missing product, exact version, destination, draft or scientific fact. Use this for ambiguous requests instead of guessing. Ends the turn awaiting a user response.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "choices": {
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        },
        "question": {
          "maxLength": 1024,
          "type": "string"
        }
      },
      "required": [
        "question"
      ],
      "type": "object"
    }
  },
  {
    "name": "catalog.search",
    "description": "Search bounded registered catalog records.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "description": "Data visibility/sensitivity, such as public, internal or restricted; not scientific quality.",
          "type": "string"
        },
        "cursor": {
          "type": "string"
        },
        "data_format": {
          "enum": [
            "parquet",
            "geotiff"
          ],
          "type": "string"
        },
        "data_kind": {
          "enum": [
            "table",
            "raster"
          ],
          "type": "string"
        },
        "limit": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "namespace": {
          "type": "string"
        },
        "owner_team": {
          "type": "string"
        },
        "quality": {
          "description": "Scientific maturity/quality, such as production, qualified or unverified.",
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  {
    "name": "product.inspect",
