  {
    "name": "publication.validate",
    "description": "Propose bounded scientific/policy edits to a locally selected draft. Returns the patch for local inspection/validation consent; does not publish or select assets. Use only user-supplied scientific facts.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "handle": {
          "type": "string"
        },
        "patch": {
          "additionalProperties": false,
          "properties": {
            "classification": {
              "maxLength": 2048,
              "type": "string"
            },
            "contact": {
              "maxLength": 2048,
              "type": "string"
            },
            "description": {
              "maxLength": 2048,
              "type": "string"
            },
            "intended_use": {
              "maxLength": 2048,
              "type": "string"
            },
            "limitations": {
              "maxLength": 2048,
              "type": "string"
            },
            "lineage": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "product": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  }
                },
                "required": [
                  "product"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "name": {
              "maxLength": 2048,
              "type": "string"
            },
            "owner_team": {
              "maxLength": 2048,
              "type": "string"
            },
            "producer": {
              "maxLength": 2048,
              "type": "string"
            },
            "quality": {
              "maxLength": 2048,
              "type": "string"
            },
            "raster": {
              "additionalProperties": false,
              "properties": {
                "bbox": {
                  "items": {
                    "type": "number"
                  },
                  "maxItems": 4,
                  "minItems": 4,
                  "type": "array"
                },
                "datetime": {
                  "type": "string"
                },
                "semantics": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              },
              "required": [
                "datetime",
                "bbox",
                "semantics"
              ],
              "type": "object"
            },
            "table": {
              "additionalProperties": false,
              "properties": {
                "column_meanings": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "column_units": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "partition_columns": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "column_meanings",
                "column_units"
              ],
              "type": "object"
            },
            "usage_policy": {
              "maxLength": 2048,
              "type": "string"
            },
            "version": {
              "maxLength": 2048,
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "handle",
        "patch"
      ],
      "type": "object"
    }
  },
  {
    "name": "publication.publish",
    "description": "Open a local review using an operations handle whose tool is publication.publish. Its metadata and inventory have ALREADY passed local validation. Private fields are intentionally omitted; do not request or invent them or revalidate this operation handle as a draft. This only opens review; it cannot publish directly.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "handle": {
          "type": "string"
        }
      },
      "required": [
        "handle"
      ],
      "type": "object"
    }
  },
  {
