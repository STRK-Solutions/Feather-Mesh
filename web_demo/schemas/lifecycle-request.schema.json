{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feam.invalid/web/v1/lifecycle-request.schema.json",
  "title": "FEAM web v1 lifecycle-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "feam.web.v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "activation_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "expected_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "authorization_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "method": {
      "enum": [
        "workspace.start",
        "workspace.stop",
        "workspace.reset",
        "workspace.delete"
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confirmation_hash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": []
    }
  },
  "required": [
    "protocol",
    "request_id",
    "idempotency_key",
    "deployment_id",
    "activation_generation",
    "workspace_id",
    "expected_generation",
    "actor_id",
    "authorization_version",
    "method",
    "parameters"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "enum": [
              "workspace.reset",
              "workspace.delete"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "required": [
              "confirmation_hash"
            ]
          }
        }
      }
    }
  ]
}
