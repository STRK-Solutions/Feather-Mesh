{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feam.invalid/web/v1/project-ledger.schema.json",
  "title": "FEAM web v1 project-ledger",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "allowance_usd_micros": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "settled_usd_micros": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "deployment_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "activation_generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "allocation_usd_micros": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "outstanding_usd_micros": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "settled_usd_micros": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "state": {
            "enum": [
              "allocated",
              "active",
              "unknown",
              "closed"
            ]
          },
          "reconciliation_hash": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "run_id",
          "deployment_id",
          "activation_generation",
          "allocation_usd_micros",
          "outstanding_usd_micros",
          "settled_usd_micros",
          "state",
          "reconciliation_hash"
        ]
      },
      "maxItems": 1000
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "revision",
    "allowance_usd_micros",
    "settled_usd_micros",
    "runs"
  ]
}
